#!/usr/bin/env python3
"""Terminal-based Snake game using curses."""

import curses
import random

UP = (-1, 0)
DOWN = (1, 0)
LEFT = (0, -1)
RIGHT = (0, 1)
DIRECTION_KEYS = {
    curses.KEY_UP: UP,
    curses.KEY_DOWN: DOWN,
    curses.KEY_LEFT: LEFT,
    curses.KEY_RIGHT: RIGHT,
    ord("w"): UP,
    ord("s"): DOWN,
    ord("a"): LEFT,
    ord("d"): RIGHT,
}


def main() -> None:
    curses.wrapper(play_game)


def play_game(stdscr: curses.window) -> None:
    curses.curs_set(0)
    stdscr.nodelay(True)
    stdscr.timeout(120)
    height, width = stdscr.getmaxyx()

    snake = [(height // 2, width // 2 + i) for i in range(3)][::-1]
    direction = LEFT
    food = place_food(height, width, snake)
    score = 0

    while True:
        key = stdscr.getch()
        new_direction = DIRECTION_KEYS.get(key)
        if new_direction and not is_opposite(direction, new_direction):
            direction = new_direction

        new_head = (snake[0][0] + direction[0], snake[0][1] + direction[1])

        if hit_wall(new_head, height, width) or new_head in snake:
            show_game_over(stdscr, score)
            break

        snake.insert(0, new_head)

        if new_head == food:
            score += 1
            food = place_food(height, width, snake)
        else:
            snake.pop()

        draw(stdscr, snake, food, score)


def place_food(height: int, width: int, snake: list[tuple[int, int]]) -> tuple[int, int]:
    while True:
        position = (random.randint(1, height - 2), random.randint(1, width - 2))
        if position not in snake:
            return position


def hit_wall(position: tuple[int, int], height: int, width: int) -> bool:
    row, col = position
    return row <= 0 or row >= height - 1 or col <= 0 or col >= width - 1


def is_opposite(current: tuple[int, int], new: tuple[int, int]) -> bool:
    return current[0] + new[0] == 0 and current[1] + new[1] == 0


def draw(
    stdscr: curses.window, snake: list[tuple[int, int]], food: tuple[int, int], score: int
) -> None:
    stdscr.clear()
    height, width = stdscr.getmaxyx()
    draw_borders(stdscr, height, width)

    for y, x in snake:
        stdscr.addch(y, x, "#")

    fy, fx = food
    stdscr.addch(fy, fx, "*")

    stdscr.addstr(0, 2, f" Score: {score} ")
    stdscr.refresh()


def draw_borders(stdscr: curses.window, height: int, width: int) -> None:
    for x in range(width):
        stdscr.addch(0, x, "-")
        stdscr.addch(height - 1, x, "-")
    for y in range(height):
        stdscr.addch(y, 0, "|")
        stdscr.addch(y, width - 1, "|")


def show_game_over(stdscr: curses.window, score: int) -> None:
    stdscr.nodelay(False)
    stdscr.clear()
    message = "Game Over! Press any key to exit"
    height, width = stdscr.getmaxyx()
    stdscr.addstr(height // 2, (width - len(message)) // 2, message)
    score_msg = f"Final Score: {score}"
    stdscr.addstr(height // 2 + 1, (width - len(score_msg)) // 2, score_msg)
    stdscr.refresh()
    stdscr.getch()


if __name__ == "__main__":
    main()
